# Required: password for the admin web UI (min 8 characters; use a long random one).
ADMIN_PASSWORD=change-me-to-something-long

# Recommended: key that encrypts stored credentials (client secrets, keys). Generate with:
#   openssl rand -base64 32
# Keep this file: the same key is needed after every restart and upgrade, or stored credentials can't be
# decrypted. If unset, one is generated into /data/secret.key (inside the volume) instead.
SECRET_KEY=

# Behind a TLS-terminating reverse proxy: trust X-Forwarded-For / X-Forwarded-Proto.
TRUST_PROXY=false
# Session cookie Secure flag: auto (when the request is HTTPS), always, never.
COOKIE_SECURE=auto

# Initial SMTP port inside the container (later changed in Settings). Admin UI port.
SMTP_PORT=25
HTTP_PORT=8080

# Published image to run. The X.Y tag gets patch releases; change it to move to a new minor version.
# Host ports published by docker-compose.
RELAY_IMAGE=ghcr.io/makizm/alertmux:0.2
SMTP_HOST_PORT=25
HTTP_HOST_PORT=8080
