# Required: password for the admin web UI (min 8 characters; use a long random one).
ADMIN_PASSWORD=change-me-to-something-long

# Recommended: key that encrypts stored credentials (client secrets, keys). If unset, one is generated
# into /data/secret.key. Generate with: openssl rand -base64 32
SECRET_KEY=

# Behind a TLS-terminating reverse proxy: trust X-Forwarded-For / X-Forwarded-Proto.
TRUST_PROXY=false
# Session cookie Secure flag: auto (when the request is HTTPS), always, never.
COOKIE_SECURE=auto

# Initial SMTP port inside the container (later changed in Settings). Admin UI port.
SMTP_PORT=25
HTTP_PORT=8080

# Image to run (pin a version such as :1.0 for predictable upgrades), and host ports published by docker-compose.
RELAY_IMAGE=ghcr.io/makizm/alertmux:latest
SMTP_HOST_PORT=25
HTTP_HOST_PORT=8080
